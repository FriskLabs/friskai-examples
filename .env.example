# FriskAI API keys (per environment)
FRISK_API_KEY_LOCAL=""
FRISK_API_KEY_STAGING=""
FRISK_API_KEY_PRODUCTION=""

# FriskAI URLs — used as-is for --frisk-env local; for staging/production the
# corresponding entry in frisk-envs.json overrides these.
FRISK_BASE_URL="http://localhost:3001/"
FRISK_TELEMETRY_ENDPOINT="https://otel-collector.docker.localhost:443"

# LLM Provider Configuration
LLM_PROVIDER=""  # Options: openai, bedrock, anthropic, ollama (defaults to ollama if not set)
FRISK_DEBUG=""

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL=""  # Optional, defaults to gpt-5-nano

# Amazon Bedrock Configuration
AWS_REGION=""  # e.g., us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID=""  # Optional, defaults to qwen.qwen3-235b-a22b-2507-v1:0

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""  # Optional, defaults to claude-3-5-sonnet-20241022

# Ollama Configuration
OLLAMA_MODEL=""  # Optional, defaults to gpt-oss:20b

# Tell gRPC (used by the OTLP trace exporter) to trust the local mkcert root CA
# that signed the collector's TLS cert. Without this, exporting traces to the
# https collector fails the TLS handshake with StatusCode.UNAVAILABLE.
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=""
